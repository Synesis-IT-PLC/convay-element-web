.mx_CallView {
    flex-grow: 1;
    min-height: 0;

    display: flex;
    flex-direction: column;

    background-color: $header-panel-bg-color;

    .mx_AppTile {
        width: auto;
        height: 100%;
        border: none;
        border-radius: inherit;
        background-color: $call-background;
        position: relative;
    }

    .mx_CallView_callDuration {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -90px);
        pointer-events: none;
        z-index: 2;
    }

    .mx_CallView_callDuration .mx_Clock {
        color: $call-primary-content;
        font-size: $font-14px;
    }
}

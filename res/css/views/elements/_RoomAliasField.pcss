.mx_RoomAliasField {
    flex: 1 1 auto;
    display: flex;
    align-items: stretch;
    width: 100%;
    min-width: 0;
    max-width: 100%;

    input {
        flex: 1 1 auto;
        min-width: 0;
        padding-left: 0;
        padding-right: 0;
    }

    input::placeholder {
        color: $info-plinth-fg-color;
        font-weight: normal;
    }

    .mx_Field_prefix {
        color: $info-plinth-fg-color;
        border-left: none;
        border-right: none;
        font-weight: var(--cpd-font-weight-semibold);
        padding: 9px 10px;
        flex: 0 0 auto;
    }
}

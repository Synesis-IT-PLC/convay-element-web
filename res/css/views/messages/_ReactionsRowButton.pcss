.mx_ReactionsRowButton {
    display: inline-flex;
    line-height: $font-20px;
    padding: 1px 6px;
    border: 1px solid var(--cpd-color-gray-400);
    border-radius: 10px;
    background-color: var(--cpd-color-gray-200);
    user-select: none;
    align-items: center;

    &.mx_ReactionsRowButton_selected {
        background-color: $accent-300;
        border-color: $accent-800;
    }

    &.mx_AccessibleButton_disabled {
        cursor: not-allowed;
    }

    .mx_ReactionsRowButton_content {
        max-width: 100px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        padding-right: 4px;
    }
}

.mx_ReactionsRowButton_reactorList {
    min-width: 200px;
    max-width: 280px;
    padding: var(--cpd-space-2x) 0;

    .mx_ReactionsRowButton_reactorList_header {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        padding: 0 var(--cpd-space-3x) var(--cpd-space-2x);
        border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);
        font-weight: var(--cpd-font-weight-semibold);
    }

    .mx_ReactionsRowButton_reactorList_items {
        list-style: none;
        margin: 0;
        padding: var(--cpd-space-1x) 0 0;
        max-height: 240px;
        overflow-y: auto;
    }

    .mx_ReactionsRowButton_reactorList_item {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-2x);
        padding: var(--cpd-space-1x) var(--cpd-space-3x);
    }

    .mx_ReactionsRowButton_reactorList_name {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
}

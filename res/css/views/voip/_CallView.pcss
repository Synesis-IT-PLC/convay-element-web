.mx_CallView {
    flex-grow: 1;
    min-height: 0;

    display: flex;
    flex-direction: column;

    background-color: $header-panel-bg-color;

    .mx_AppTile {
        width: auto;
        height: 100%;
        border: none;
        border-radius: inherit;
        background-color: $call-background;
        position: relative;
    }
}

/*
 * Call overlays are rendered inside PersistedElement (ported to document.body),
 * so these rules must not be nested under .mx_CallView.
 * Also override .mx_AppTile_persistedWrapper div { width/height: 100% }.
 */
.mx_CallView_callDuration {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -90px);
    pointer-events: none;
    z-index: 2;
    width: auto !important;
    height: auto !important;
}

.mx_CallView_callDuration .mx_Clock {
    color: $call-primary-content;
    font-size: $font-14px;
}

/*
 * Recording control is portaled into the Element Call iframe (fixed top-left
 * inside that document) so it stays within the call widget at every size.
 * Keep these rules as a fallback if the host ever renders in the parent page.
 */
.mx_CallView_recordingControls {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 3;
    pointer-events: auto;
    width: auto !important;
    height: auto !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
}

.mx_CallView_recordingButton {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px !important;
    height: 42px !important;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.92);
    color: #1b1d22;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);

    &:hover {
        filter: brightness(0.96);
    }

    &.mx_CallView_recordingButton_active {
        background-color: rgba(0, 0, 0, 0.75);
        color: #ff4b55;
    }
}

.mx_CallView_recordingButton_dot {
    display: block;
    width: 14px !important;
    height: 14px !important;
    border-radius: 50%;
    background-color: #ff4b55;
}

.mx_CallView_recordingLabel {
    font-size: 12px;
    line-height: 1.2;
    font-weight: 600;
    color: #1b1d22;
    text-shadow: 0 0 4px rgba(255, 255, 255, 0.9);
    user-select: none;
    pointer-events: none;
}

.mx_CallView_recordingControls:has(.mx_CallView_recordingButton_active) .mx_CallView_recordingLabel {
    color: #ff4b55;
}
